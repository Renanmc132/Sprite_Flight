:root {
}

.button {
    background-image: url("project://database/Assets/DEVNIK%202D/2D%20UI%20PIXEL%20BUTTONS/UI%20SIMPLE%20PIXEL%20UNSPLIT.png?fileID=-1397424353&guid=a37e8466236089c45b610370218b5353&type=3#BAR1");
    -unity-slice-type: sliced;
    -unity-text-align: middle-center;
    align-items: center;
    align-self: center;
    justify-content: center;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    background-position-x: center;
    -unity-slice-left: 0;
    background-color: rgba(0, 0, 0, 0);
}
